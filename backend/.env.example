PORT=8787
ADMIN_RESET_JWT_SECRET=replace-with-long-random-secret
ADMIN_RESET_TTL_MIN=30
ALLOWED_ORIGIN=https://taha-farooq.github.io
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
SCAN_POLL_MS=8000
SCAN_MIN_FILE_AGE_MS=3000
FRONTEND_URL=https://taha-farooq.github.io/catering-inventory-manager/
ATTENDANCE_QR_TTL_SEC=60
# Session JWT lifetime (default 30 days). Format accepted by jsonwebtoken.
SESSION_TTL=30d
# bcrypt cost factor for stored credentials (default 10).
BCRYPT_COST=10
# Timezone used for payroll week boundaries (default America/New_York).
TIMEZONE=America/New_York
# SECURITY (SECURITY_REVIEW.md A11): when set, the Scan DB will refuse
# inboxPath / libraryPath values that don't live under this directory. Strongly
# recommended for the Windows on-prem install (e.g. set to
# %USERPROFILE%\Documents\CateringScans).
SCAN_ROOT=
# PDF safety caps for the scan job.
SCAN_MAX_PDF_BYTES=52428800
SCAN_PARSE_TIMEOUT_MS=30000
